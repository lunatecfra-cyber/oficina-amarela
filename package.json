{
  "name": "oficina-amarela",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "d1s": "bunx d1s --dir packages/db",
    "db:studio": "bunx d1s --dir packages/db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "turbo": "^2.10.12"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
