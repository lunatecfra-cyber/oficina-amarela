{
  "name": "@oficina/web",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import ./scripts/test-alias-hooks.mjs --test --test-concurrency=1 lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "build:vinext:staging": "CLOUDFLARE_ENV=staging vinext build",
    "build:vinext:production": "CLOUDFLARE_ENV=production vinext build",
    "deploy:staging": "vinext-cloudflare deploy --env staging",
    "deploy:production": "vinext-cloudflare deploy --env production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@oficina/api": "*",
    "@oficina/auth": "*",
    "@oficina/config": "*",
    "@oficina/db": "*",
    "@oficina/domain": "*",
    "@oficina/email": "*",
    "@sentry/nextjs": "^11.9.0",
    "@vinext/cloudflare": "^1.2.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vinext": "^1.3.1",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  }
}
